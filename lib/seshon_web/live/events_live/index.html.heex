<Layouts.app socket={@socket} flash={@flash} current_scope={@current_scope}>
  <div class="grid gap-6 md:grid-cols-3 items-start">
    <div class="md:col-span-2 space-y-4">
      <.header>
        <h2 class="text-3xl font-serif text-stone-900">Seshes</h2>
        <:actions>
          <div class="flex items-center gap-3">
            <.button href={~p"/events/new"} variant="primary">
              <.icon name="hero-plus" class="w-6 h-6" />
            </.button>
            <.profile_dropdown user={@current_scope.user} />
          </div>
        </:actions>
      </.header>

      <div class="flex flex-col space-y-2">
        <%= for event <- @events do %>
          <EventCardComponent.event_card event={event} />
        <% end %>
      </div>

      <%= if Enum.empty?(@events) do %>
        <div class="text-center py-12">
          <div class="max-w-md mx-auto">
            <.icon name="hero-calendar-days" class="w-16 h-16 text-base-content/30 mx-auto mb-4" />
            <h3 class="text-lg font-semibold text-base-content/70 mb-2">No sesh yet</h3>
            <p class="text-base-content/50 mb-6">Create your first sesh to get started!</p>
            <.link navigate={~p"/events/new"} class="btn btn-primary">
              <.icon name="hero-plus" class="w-4 h-4" />
            </.link>
          </div>
        </div>
      <% end %>
    </div>

    <aside class="space-y-5 md:mt-18">
      <div class="card bg-base-100 border border-base-200 shadow-sm">
        <div class="card-body p-4 space-y-4 md:space-y-0 md:grid md:grid-cols-2 md:gap-6">
          <div class="flex items-center justify-between md:col-span-2">
            <h3 class="card-title text-lg">Friends</h3>
            <div class="relative">
              <button
                type="button"
                class="btn btn-ghost btn-circle btn-sm hover:opacity-80"
                phx-click={JS.toggle(to: "#friends-widget-panel")}
              >
                <.icon name="hero-user-plus" class="size-5 opacity-75 hover:opacity-100" />
              </button>

              <div
                id="friends-widget-panel"
                class="hidden absolute right-0 top-10 z-40 w-96 max-h-[70vh] overflow-y-auto card bg-base-100 border border-base-200 shadow"
                phx-click-away={JS.hide(to: "#friends-widget-panel")}
              >
                <.live_component
                  module={SeshonWeb.FriendshipsWidget}
                  id="friends-widget-inline"
                  current_scope={@current_scope}
                  mode={:panel}
                />
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <%= if Enum.empty?(@friends) do %>
              <p class="text-sm text-base-content/70">Add some mates!</p>
            <% else %>
              <div
                :for={friend <- @friends}
                class="flex items-center gap-3 p-3 rounded-lg hover:bg-base-200/60 transition-colors"
              >
                <% friend_user = other_user(friend, @current_scope.user.id) %>
                <.avatar user={friend_user} size="md" class="shrink-0" />
                <div class="flex-1">
                  <p class="font-medium text-base-content">{friend_user.first_name} {friend_user.last_name}</p>
                  <p class="text-sm text-base-content/70">{friend_user.email}</p>
                </div>
              </div>
            <% end %>
          </div>

        </div>
      </div>
    </aside>
  </div>
</Layouts.app>
